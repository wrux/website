---
/**
 * The face logo. Rendered as an <img> so the 100 KB+ artwork is a cached asset
 * rather than inline markup on every page. Size it with font-size: the image is
 * 1em tall and keeps its aspect ratio, so `class="text-7xl"` still works.
 */
import logo from '~/images/logo.svg';

const { class: className, ...rest } = Astro.props;
---

<img
  src={logo.src}
  width={logo.width}
  height={logo.height}
  alt=""
  class={className}
  style="height: 1em; width: auto;"
  draggable="false"
  {...rest}
/>
