---
import '@fontsource-variable/manrope';
import '~/styles/app.css';
// Preload the critical Latin font file for iOS Safari.
import manropeLatinFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import TopBar from '~/components/TopBar.astro';
import { person, sourceUrl } from '~/data/site';

export interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link
      rel="preload"
      href={manropeLatinFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#17181a" />
    <meta name="msapplication-TileColor" content="#e9e8e3" />
    <meta name="theme-color" content="#e9e8e3" />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="w-full overflow-x-clip bg-[var(--page-bg)] text-[var(--ink)] antialiased">
    <div class="site container flex min-h-svh flex-col font-sans">
      <TopBar />

      <main class="flex-1 space-y-5 pb-10 pt-2">
        <slot />
      </main>

      <footer class="print:hidden">
        <div
          class="flex flex-col items-center justify-center gap-2 px-2 py-8 text-sm text-[var(--ink-soft)] sm:flex-row sm:gap-4"
        >
          <span>&copy; {new Date().getFullYear()} {person.name}</span>
          <span class="hidden sm:inline">&middot;</span>
          <a
            href={sourceUrl}
            target="_blank"
            rel="nofollow noreferrer"
            class="link-hover"
          >
            Source on GitHub
          </a>
        </div>
      </footer>
    </div>
  </body>
</html>
