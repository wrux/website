---
import Layout from '~/layouts/Layout.astro';
import CvMasthead from '~/components/CvMasthead.astro';
import { getCollection } from 'astro:content';
import {
  cvHighlights,
  cvSkillGroups,
  education,
  home,
  person,
  professionalPortfolio,
} from '~/data/site';
import { Icon } from 'astro-icon/components';
import { formatISODate, formatTenure, sortJobs } from '~/lib/jobs';

const sortedJobs = sortJobs(await getCollection('jobs'));

const displayUrl = (url: string) =>
  url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const displayPhone = (phone: string) =>
  phone.replace(/^\+44(\d{4})(\d{6})$/, '+44 $1 $2');

const contactItems = [
  {
    label: 'Location',
    value: person.location,
    href: null,
    itemprop: 'homeLocation',
    printOnly: true,
  },
  {
    label: 'Email',
    value: person.contact.email,
    href: person.contact.email ? `mailto:${person.contact.email}` : null,
    itemprop: 'email',
  },
  {
    label: 'Phone',
    value: person.contact.phone ? displayPhone(person.contact.phone) : '',
    href: person.contact.phone ? `tel:${person.contact.phone}` : null,
    itemprop: 'telephone',
  },
  {
    label: 'Website',
    value: displayUrl(person.website),
    href: person.website,
    itemprop: 'url',
  },
  {
    label: 'LinkedIn',
    value: displayUrl(person.contact.linkedin),
    href: person.contact.linkedin,
    itemprop: 'sameAs',
  },
  {
    label: 'GitHub',
    value: displayUrl(person.contact.github),
    href: person.contact.github,
    itemprop: 'sameAs',
  },
].filter((item) => item.value);

const sameAs = [
  person.contact.linkedin,
  person.contact.github,
  person.website,
  person.blog,
].filter(Boolean);

const cvKnowsAbout = [
  ...new Set([
    ...person.skills,
    ...cvSkillGroups.flatMap((group) => group.skills),
  ]),
];

const cvMetaDescription = `${person.name}, ${person.role} in ${person.location}. ${person.summary}`;

const cvStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  description: person.summary,
  url: person.website,
  email: person.contact.email || undefined,
  telephone: person.contact.phone || undefined,
  address: {
    '@type': 'PostalAddress',
    addressLocality: person.location,
  },
  sameAs,
  knowsAbout: cvKnowsAbout,
  hasCredential: education.map((school) => ({
    '@type': 'EducationalOccupationalCredential',
    name: school.degree,
    credentialCategory: school.summary,
    recognizedBy: {
      '@type': 'EducationalOrganization',
      name: school.institution,
      address: school.location,
    },
  })),
  alumniOf: education.map((school) => ({
    '@type': 'CollegeOrUniversity',
    name: school.institution,
    address: school.location,
  })),
  hasOccupation: {
    '@type': 'Occupation',
    name: person.role,
    skills: cvKnowsAbout,
  },
  workExample: professionalPortfolio.map((project) => ({
    '@type': 'CreativeWork',
    name: project.name,
    alternateName: project.subtitle,
    description: project.description,
    url: project.urls[0]?.href,
    sameAs: project.urls.map((url) => url.href),
    keywords: project.skills,
  })),
  workExperience: sortedJobs.map((job) => ({
    '@type': 'Role',
    roleName: job.data.title,
    description: job.data.description?.join(' '),
    startDate: formatISODate(job.data.tenure.from),
    endDate: job.data.tenure.to ? formatISODate(job.data.tenure.to) : undefined,
    worksFor: {
      '@type': 'Organization',
      name: job.data.company,
      address: job.data.location,
    },
  })),
};

const cvStructuredDataJson = JSON.stringify(cvStructuredData).replace(
  /</g,
  '\\u003c',
);

const atAGlance = [
  { label: 'Experience', value: '12 years' },
  { label: 'Own products', value: 'kacet, Banburyshire, blot.tools' },
  { label: 'Latest launch', value: 'blot.tools, 2026' },
  { label: 'Location', value: `${person.location}, remote-friendly` },
];

const bulletListClass =
  'cv-bullets mt-3 max-w-[70ch] list-disc space-y-2 pl-5 text-[15px] leading-relaxed text-[var(--ink-muted)]';
---

<Layout title={`CV | ${person.name}`} description={cvMetaDescription}>
  <script type="application/ld+json" set:html={cvStructuredDataJson} />

  <article
    class="cv-document grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:grid-flow-row-dense"
    itemscope
    itemtype="https://schema.org/Person"
  >
    <CvMasthead contactItems={contactItems} />

    <aside class="tile tile-dark flex flex-col justify-between gap-8 print:hidden sm:col-span-1" aria-labelledby="cv-get-heading">
      <div class="flex flex-col gap-2">
        <h2 id="cv-get-heading" class="eyebrow text-[var(--ink-soft-on-dark)]">Get the CV</h2>
        <p class="text-[15px] leading-snug text-[var(--ink-muted-on-dark)]">Two A4 pages with the same content as this page.</p>
      </div>
      <div class="flex flex-col gap-2">
        <button type="button" class="btn w-full justify-center" data-print>Save as PDF</button>
        <a href={`mailto:${person.contact.email}`} class="btn btn-outline-light w-full justify-center">Email me</a>
      </div>
    </aside>

    <section class="cv-section tile scroll-mt-5 sm:col-span-2 lg:col-span-3" id="cv-summary" aria-labelledby="cv-summary-heading">
      <h2 id="cv-summary-heading" class="eyebrow">Summary</h2>
      <p
        class="cv-summary mt-5 max-w-[70ch] text-pretty text-lg leading-relaxed text-[var(--ink)]"
        itemprop="description"
      >
        {person.summary}
      </p>
    </section>

    <section class="tile flex flex-col gap-6 print:hidden" aria-labelledby="cv-glance-heading">
      <h2 id="cv-glance-heading" class="eyebrow">At a glance</h2>
      <dl class="flex flex-col divide-y divide-[var(--rule)]">
        {
          atAGlance.map((item) => (
            <div class="flex flex-col gap-0.5 py-3 first:pt-0 last:pb-0">
              <dt class="text-[13px] text-[var(--ink-soft)]">{item.label}</dt>
              <dd class="text-[15px] font-semibold text-[var(--ink)]">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv-section cv-highlights-tile hidden print:block sm:col-span-2 lg:col-span-4" aria-labelledby="cv-highlights-heading">
      <h2 id="cv-highlights-heading" class="cv-subheading eyebrow">Highlights</h2>
      <ul class="cv-bullets cv-highlights mt-4 list-disc pl-5 text-[15px] text-[var(--ink-muted)]">
        {cvHighlights.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="cv-section tile scroll-mt-5 lg:col-start-4" id="cv-skills" aria-labelledby="cv-skills-heading">
      <h2 id="cv-skills-heading" class="eyebrow">Skills</h2>
      <dl class="cv-skills mt-5 flex flex-col gap-5">
        {
          cvSkillGroups.map((group) => (
            <div class="cv-skill-row flex flex-col gap-2">
              <dt class="text-[15px] font-semibold text-[var(--ink)]">{group.name}</dt>
              <dd class="cv-skill-chips flex flex-wrap gap-1.5">
                {group.skills.map((skill) => (
                  <span class="chip">{skill}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section
      class="cv-section cv-experience tile scroll-mt-5 sm:col-span-2 lg:col-span-3 lg:row-span-2"
      id="cv-experience"
      aria-labelledby="cv-experience-heading"
    >
      <h2 id="cv-experience-heading" class="eyebrow">Experience</h2>
      <ul class="cv-job-list mt-5 flex flex-col">
        {
          sortedJobs.map((job) => (
            <li class="cv-job">
              <h3 class="cv-job-title text-lg font-bold tracking-tight text-[var(--ink)]">
                {job.data.title}
              </h3>
              <p class="cv-job-dates text-[15px] tabular-nums text-[var(--ink)] lg:font-semibold">
                {formatTenure(job.data.tenure)}
              </p>
              <p class="cv-job-meta text-[15px] text-[var(--ink-muted)]">
                {job.data.company} · {job.data.location}
              </p>
              {job.data.description && (
                <ul class={bulletListClass}>
                  {job.data.description.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="cv-section cv-projects tile scroll-mt-5 sm:col-span-2 lg:col-span-4"
      id="cv-projects"
      aria-labelledby="cv-projects-heading"
    >
      <h2 id="cv-projects-heading" class="eyebrow">Selected work</h2>
      <ul class="cv-project-list mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {
          professionalPortfolio.map((project, index) => (
            <li
              class:list={['cv-project flex flex-col gap-5', index === 0 && 'lg:col-span-2']}
              itemprop="workExample"
              itemscope
              itemtype="https://schema.org/CreativeWork"
            >
              <div class="cv-project-head flex items-start justify-between gap-3">
                <div class="flex min-w-0 flex-col gap-1">
                  <span class="eyebrow print:hidden">{project.kind}</span>
                  <h3
                    class="text-xl font-bold tracking-tight text-[var(--ink)]"
                    itemprop="name"
                  >
                    {project.name}
                  </h3>
                  <p class="flex flex-wrap gap-x-3 gap-y-1">
                    {project.urls.map((url) => (
                      <a
                        href={url.href}
                        target="_blank"
                        rel="nofollow noreferrer"
                        class="cv-project-link cv-print-visible-url link-hover text-sm text-[var(--accent)]"
                        itemprop="url"
                      >
                        {url.label}
                      </a>
                    ))}
                  </p>
                </div>
                {project.urls[0] && (
                  <a
                    href={project.urls[0].href}
                    target="_blank"
                    rel="nofollow noreferrer"
                    class="cv-project-arrow flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--tile-bg)] text-[var(--ink)] transition-colors hover:bg-[var(--ink)] hover:text-white print:hidden"
                    aria-label={`Open ${project.name}`}
                  >
                    <Icon name="lucide:arrow-up-right" size={18} />
                  </a>
                )}
              </div>
              <p
                class="cv-project-desc text-[15px] leading-relaxed text-[var(--ink-muted)]"
                itemprop="description"
              >
                {project.description}
              </p>
              <ul
                class="cv-project-stack mt-auto flex flex-wrap gap-1.5"
                aria-label={`${project.name} stack`}
              >
                {project.skills.map((skill) => (
                  <li class="chip chip-sm">{skill}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="cv-section cv-education tile scroll-mt-5 lg:col-start-4"
      id="cv-education"
      aria-labelledby="cv-education-heading"
    >
      <h2 id="cv-education-heading" class="eyebrow">Education</h2>
      <ul class="cv-edu-list mt-5 flex flex-col gap-5">
        {
          education.map((school) => (
            <li class="cv-edu flex flex-col gap-1">
              <h3 class="text-lg font-bold tracking-tight text-[var(--ink)]">
                {school.degree}
              </h3>
              <p class="text-[15px] text-[var(--ink-muted)]">
                {school.institution} · {school.location}
              </p>
              <p class="text-[15px] text-[var(--ink-muted)]">{school.summary} · <span class="tabular-nums">{school.period}</span></p>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-print]')
    .forEach((el) => el.addEventListener('click', () => window.print()));
</script>
