---
import Layout from '~/layouts/Layout.astro';
import CvMasthead from '~/components/CvMasthead.astro';
import { getCollection } from 'astro:content';
import {
  cvHighlights,
  cvSkillGroups,
  education,
  person,
  professionalPortfolio,
} from '~/data/site';
import { Icon } from 'astro-icon/components';

const jobs = await getCollection('jobs');

const parseDate = (value: string) => {
  const [day, month, year] = value.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, day));
};

const formatMonthYear = (value: string) =>
  new Intl.DateTimeFormat('en-GB', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(parseDate(value));

const formatISODate = (value: string) =>
  parseDate(value).toISOString().slice(0, 10);

const formatTenure = (tenure: { from: string; to: string | null }) => {
  const from = formatMonthYear(tenure.from);
  const to = tenure.to ? formatMonthYear(tenure.to) : 'Present';
  return `${from} – ${to}`;
};

const sortedJobs = [...jobs].sort((a, b) => {
  const aTo = a.data.tenure.to
    ? parseDate(a.data.tenure.to).getTime()
    : Number.POSITIVE_INFINITY;
  const bTo = b.data.tenure.to
    ? parseDate(b.data.tenure.to).getTime()
    : Number.POSITIVE_INFINITY;

  if (aTo !== bTo) {
    return bTo - aTo;
  }

  return (
    parseDate(b.data.tenure.from).getTime() -
    parseDate(a.data.tenure.from).getTime()
  );
});

const displayUrl = (url: string) =>
  url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const displayPhone = (phone: string) =>
  phone.replace(/^\+44(\d{4})(\d{6})$/, '+44 $1 $2');

const contactItems = [
  {
    label: 'Location',
    value: person.location,
    href: null,
    itemprop: 'homeLocation',
  },
  {
    label: 'Email',
    value: person.contact.email,
    href: person.contact.email ? `mailto:${person.contact.email}` : null,
    itemprop: 'email',
  },
  {
    label: 'Phone',
    value: person.contact.phone ? displayPhone(person.contact.phone) : '',
    href: person.contact.phone ? `tel:${person.contact.phone}` : null,
    itemprop: 'telephone',
  },
  {
    label: 'Website',
    value: displayUrl(person.website),
    href: person.website,
    itemprop: 'url',
  },
  {
    label: 'LinkedIn',
    value: displayUrl(person.contact.linkedin),
    href: person.contact.linkedin,
    itemprop: 'sameAs',
  },
  {
    label: 'GitHub',
    value: displayUrl(person.contact.github),
    href: person.contact.github,
    itemprop: 'sameAs',
  },
].filter((item) => item.value);

const sameAs = [
  person.contact.linkedin,
  person.contact.github,
  person.website,
  person.blog,
].filter(Boolean);

const cvKnowsAbout = [
  ...new Set([
    ...person.skills,
    ...cvSkillGroups.flatMap((group) => group.skills),
  ]),
];

const cvMetaDescription = `${person.name}, ${person.role} in ${person.location}. ${person.summary}`;

const cvStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  description: person.summary,
  url: person.website,
  email: person.contact.email || undefined,
  telephone: person.contact.phone || undefined,
  address: {
    '@type': 'PostalAddress',
    addressLocality: person.location,
  },
  sameAs,
  knowsAbout: cvKnowsAbout,
  hasCredential: education.map((school) => ({
    '@type': 'EducationalOccupationalCredential',
    name: school.degree,
    credentialCategory: school.summary,
    recognizedBy: {
      '@type': 'EducationalOrganization',
      name: school.institution,
      address: school.location,
    },
  })),
  alumniOf: education.map((school) => ({
    '@type': 'CollegeOrUniversity',
    name: school.institution,
    address: school.location,
  })),
  hasOccupation: {
    '@type': 'Occupation',
    name: person.role,
    skills: cvKnowsAbout,
  },
  workExample: professionalPortfolio.map((project) => ({
    '@type': 'CreativeWork',
    name: project.name,
    alternateName: project.subtitle,
    description: project.description,
    url: project.urls[0]?.href,
    sameAs: project.urls.map((url) => url.href),
    keywords: project.skills,
  })),
  workExperience: sortedJobs.map((job) => ({
    '@type': 'Role',
    roleName: job.data.title,
    description: job.data.description?.join(' '),
    startDate: formatISODate(job.data.tenure.from),
    endDate: job.data.tenure.to ? formatISODate(job.data.tenure.to) : undefined,
    worksFor: {
      '@type': 'Organization',
      name: job.data.company,
      address: job.data.location,
    },
  })),
};

const cvStructuredDataJson = JSON.stringify(cvStructuredData).replace(
  /</g,
  '\\u003c',
);

const sectionHeadingClass =
  'flex items-center gap-2 text-lg font-semibold text-[var(--text)]';
const bulletListClass =
  'cv-bullets mt-3 max-w-prose list-disc space-y-2 pl-5 text-sm text-[var(--text-muted)]';
---

<Layout title={`CV | ${person.name}`} description={cvMetaDescription}>
  <CvMasthead slot="header" contactItems={contactItems} />

  <script type="application/ld+json" set:html={cvStructuredDataJson} />

  <article
    class="cv-document space-y-8"
    itemscope
    itemtype="https://schema.org/Person"
  >
    <section class="cv-section terminal-card p-6" aria-labelledby="cv-summary">
      <h2 id="cv-summary" class={sectionHeadingClass}>
        <Icon
          name="lucide:file-text"
          size={20}
          class="text-[var(--accent)] print:text-black"
        />
        Summary
      </h2>
      <p
        class="cv-summary mt-3 max-w-prose text-base leading-relaxed text-[var(--text-muted)]"
        itemprop="description"
      >
        {person.summary}
      </p>
      <h3
        class="cv-subheading mt-5 text-sm font-semibold uppercase tracking-wide text-[var(--accent)]"
      >
        Highlights
      </h3>
      <ul class={bulletListClass}>
        {cvHighlights.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="cv-section terminal-card p-6" aria-labelledby="cv-skills">
      <h2 id="cv-skills" class={sectionHeadingClass}>
        <Icon
          name="lucide:sparkles"
          size={20}
          class="text-[var(--accent)] print:text-black"
        />
        Skills
      </h2>
      <dl class="cv-skills mt-4 divide-y divide-[var(--rule)] text-sm">
        {
          cvSkillGroups.map((group) => (
            <div class="cv-skill-row grid gap-1 py-2.5 first:pt-0 last:pb-0 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-5">
              <dt class="font-semibold text-[var(--accent)]">{group.name}</dt>
              <dd class="leading-relaxed text-[var(--text-muted)]">
                {group.skills.join(', ')}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section
      class="cv-section cv-experience terminal-card p-6"
      aria-labelledby="cv-experience"
    >
      <h2 id="cv-experience" class={sectionHeadingClass}>
        <Icon
          name="lucide:briefcase"
          size={20}
          class="text-[var(--accent)] print:text-black"
        />
        Experience
      </h2>
      <ul class="cv-job-list mt-5 flex flex-col gap-6">
        {
          sortedJobs.map((job) => (
            <li class="cv-job terminal-item">
              <div class="cv-job-head flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <h3 class="text-base font-semibold text-[var(--text)]">
                  {job.data.title}
                </h3>
                <p class="cv-job-dates shrink-0 text-sm text-[var(--accent)]">
                  {formatTenure(job.data.tenure)}
                </p>
              </div>
              <p class="cv-job-meta text-sm text-[var(--text-muted)]">
                {job.data.company} · {job.data.location}
              </p>
              {job.data.description && (
                <ul class={bulletListClass}>
                  {job.data.description.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="cv-section cv-projects terminal-card p-6"
      aria-labelledby="cv-projects"
    >
      <h2 id="cv-projects" class={sectionHeadingClass}>
        <Icon
          name="lucide:folder-git-2"
          size={20}
          class="text-[var(--accent)] print:text-black"
        />
        Selected Work
      </h2>
      <ul class="cv-project-list mt-5 grid gap-4 md:grid-cols-2">
        {
          professionalPortfolio.map((project) => (
            <li
              class="cv-project terminal-item"
              itemprop="workExample"
              itemscope
              itemtype="https://schema.org/CreativeWork"
            >
              <div class="cv-project-head flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3
                  class="text-base font-semibold text-[var(--text)]"
                  itemprop="name"
                >
                  {project.name}
                </h3>
                {project.urls.map((url) => (
                  <a
                    href={url.href}
                    target="_blank"
                    rel="nofollow noreferrer"
                    class="cv-project-link cv-print-visible-url link-hover text-sm text-[var(--text-muted)]"
                    itemprop="url"
                  >
                    {url.label}
                  </a>
                ))}
              </div>
              <p
                class="cv-project-desc mt-2 text-sm text-[var(--text-muted)]"
                itemprop="description"
              >
                {project.description}
              </p>
              <p
                class="cv-project-stack mt-2 text-xs uppercase tracking-wide text-[var(--accent)]"
                aria-label={`${project.name} stack`}
              >
                {project.skills.join(' · ')}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="cv-section cv-education terminal-card p-6"
      aria-labelledby="cv-education"
    >
      <h2 id="cv-education" class={sectionHeadingClass}>
        <Icon
          name="lucide:graduation-cap"
          size={20}
          class="text-[var(--accent)] print:text-black"
        />
        Education
      </h2>
      <ul class="cv-edu-list mt-5 grid gap-5 sm:grid-cols-2">
        {
          education.map((school) => (
            <li class="cv-edu terminal-item">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <h3 class="text-base font-semibold text-[var(--text)]">
                  {school.degree}
                </h3>
                <p class="shrink-0 text-sm text-[var(--accent)]">{school.period}</p>
              </div>
              <p class="text-sm text-[var(--text-muted)]">
                {school.institution} · {school.location}
              </p>
              <p class="mt-1 text-sm text-[var(--text-muted)]">{school.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>
