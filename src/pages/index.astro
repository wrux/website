---
import Layout from '~/layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { home, person } from '~/data/site';
import { formatYearRange, sortJobs } from '~/lib/jobs';
import portrait from '~/images/portrait.jpg';
import brandBanburyshire from '~/images/brand-banburyshire.jpg';
import brandKacet from '~/images/brand-kacet.jpg';

const brandImages = { banburyshire: brandBanburyshire, kacet: brandKacet } as const;
const brandStyle = (b: { overlay: string; fg: string; muted: string; accent: string }) =>
  `--brand-overlay: ${b.overlay}; --brand-fg: ${b.fg}; --brand-muted: ${b.muted}; --brand-accent: ${b.accent};`;

const jobs = sortJobs(await getCollection('jobs'));

const description = `${person.name}, ${person.role} in ${person.location}. ${home.intro}`;
---

<Layout title={`${person.name} · ${person.role}`} description={description}>
  <div class="bento grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:auto-rows-[240px]">

    <section class="tile flex flex-col justify-between gap-8 sm:col-span-2 lg:row-span-2 lg:p-9" aria-labelledby="intro">
      <p class="eyebrow">{person.role} · {person.location}</p>
      <div class="flex flex-col gap-4">
        <h1 id="intro" class="text-balance text-5xl font-bold leading-[1.02] tracking-[-0.03em] sm:text-6xl lg:text-[68px]">
          {home.headline}
        </h1>
        <p class="text-pretty text-base leading-relaxed text-[var(--ink-muted)] sm:text-lg">{home.intro}</p>
      </div>
    </section>

    <figure class="tile relative min-h-[420px] overflow-hidden p-0 sm:min-h-0 lg:row-span-2">
      <Image
        src={portrait}
        alt={`${person.name} standing in front of a painted mural`}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
        class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover object-[62%_60%] lg:object-[50%_30%]"
        draggable="false"
        loading="eager"
      />
    </figure>

    <section class="tile flex flex-col justify-between gap-6" aria-labelledby="status">
      <p id="status" class="eyebrow">Status</p>
      <div class="flex flex-col gap-2">
        <p class="flex items-center gap-2.5 text-[22px] font-bold tracking-tight">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-[var(--ok)]" aria-hidden="true"></span>
          {home.status.label}
        </p>
        <p class="text-[15px] leading-snug text-[var(--ink-muted)]">{home.status.detail}</p>
      </div>
    </section>

    <a
      href={home.latest.href}
      target="_blank"
      rel="noreferrer"
      class="tile tile-link tile-brand relative flex flex-col justify-between gap-6 overflow-hidden"
      style={brandStyle(home.latest.brand)}
    >
      <span class="brand-motif" aria-hidden="true">{home.latest.brand.motif}</span>
      <span class="relative flex items-center justify-between">
        <span class="eyebrow brand-eyebrow">Latest launch</span>
        <Icon name="lucide:arrow-up-right" size={20} class="shrink-0" />
      </span>
      <span class="relative flex flex-col gap-1.5">
        <span class="text-[28px] font-bold tracking-tight">{home.latest.name}</span>
        <span class="text-[15px] leading-snug text-[var(--brand-muted)]">{home.latest.blurb}</span>
      </span>
    </a>

    {
      home.products.map((product) => (
        <a
          href={product.href}
          target="_blank"
          rel="noreferrer"
          class="tile tile-link tile-brand relative flex flex-col justify-between gap-6 overflow-hidden"
          style={brandStyle(product.brand)}
        >
          <Image
            src={brandImages[product.brand.image]}
            alt=""
            widths={[400, 800]}
            sizes="(min-width: 1024px) 330px, (min-width: 640px) 50vw, 100vw"
            class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover"
            aria-hidden="true"
          />
          <span class="brand-overlay absolute inset-0" aria-hidden="true"></span>
          <span class="relative flex items-center justify-between">
            <span class="eyebrow brand-eyebrow">Own product</span>
            <Icon name="lucide:arrow-up-right" size={20} class="shrink-0" />
          </span>
          <span class="relative flex flex-col gap-1.5">
            <span class="text-[26px] font-bold tracking-tight">{product.name}</span>
            <span class="text-[15px] leading-snug text-[var(--brand-muted)]">{product.blurb}</span>
          </span>
        </a>
      ))
    }

    <section class="tile flex flex-col justify-between gap-6 sm:col-span-2" aria-labelledby="client-work">
      <div class="flex items-center justify-between">
        <p id="client-work" class="eyebrow">Client work</p>
        <a href="/cv#cv-projects" class="text-[13px] font-semibold text-[var(--accent)] link-hover">All work</a>
      </div>
      <ul class="flex flex-col gap-2.5 text-[15px]">
        {
          home.clientWork.map((item) => (
            <li class="flex flex-col justify-between gap-0.5 sm:flex-row sm:gap-4">
              {item.href ? (
                <a href={item.href} target="_blank" rel="noreferrer" class="link-hover font-semibold">{item.name}</a>
              ) : (
                <span class="font-semibold">{item.name}</span>
              )}
              <span class="shrink-0 text-[var(--ink-soft)]">{item.meta}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="tile flex flex-col justify-between gap-6 sm:col-span-2" aria-labelledby="stack">
      <p id="stack" class="eyebrow">Stack</p>
      <ul class="flex flex-wrap gap-2">
        {home.stack.map((item) => <li class="chip">{item}</li>)}
      </ul>
    </section>

    <section class="tile flex flex-col justify-between gap-6 sm:col-span-2" aria-labelledby="experience">
      <div class="flex items-center justify-between">
        <p id="experience" class="eyebrow">Experience</p>
        <a href="/cv" class="text-[13px] font-semibold text-[var(--accent)] link-hover">Full CV</a>
      </div>
      <ul class="flex flex-col gap-2.5 text-[15px]">
        {
          jobs.map((job) => (
            <li class="flex flex-col justify-between gap-0.5 sm:flex-row sm:gap-4">
              <span class="font-semibold">{job.data.company} · {job.data.title.replace(/\s*\(Contract\)$/, '')}</span>
              <span class="shrink-0 tabular-nums text-[var(--ink-soft)]">{formatYearRange(job.data.tenure)}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="tile tile-accent flex flex-col justify-between gap-6 sm:col-span-2" aria-labelledby="contact">
      <p id="contact" class="eyebrow text-white/70">Contact</p>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <a href={`mailto:${person.contact.email}`} class="break-all text-2xl font-bold tracking-tight sm:text-[34px]">{person.contact.email}</a>
        <div class="flex gap-2">
          <a href={person.contact.github} target="_blank" rel="noreferrer" class="btn btn-outline-light">GitHub</a>
          <a href={person.contact.linkedin} target="_blank" rel="noreferrer" class="btn btn-outline-light">LinkedIn</a>
        </div>
      </div>
    </section>

    <section class="tile flex flex-col justify-between gap-6 sm:col-span-2" aria-labelledby="off-the-clock">
      <p id="off-the-clock" class="eyebrow">Off the clock</p>
      <ul class="grid gap-5 sm:grid-cols-3">
        {
          home.offTheClock.map((item) => (
            <li class="flex flex-col gap-1">
              <a href={item.href} target="_blank" rel="noreferrer" class="link-hover text-lg font-bold tracking-tight">{item.name}</a>
              <span class="text-sm leading-snug text-[var(--ink-muted)]">{item.blurb}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
